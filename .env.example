COMPOSE_PROJECT_NAME=p1_reliability_lab
RESOURCE_PROFILE=small

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_CONTAINER=mysql
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=cdc_lab
MYSQL_USER=cdc
MYSQL_PASSWORD=cdc_pw

ICEBERG_CATALOG_DATABASE=iceberg_catalog
ICEBERG_CATALOG_NAME=lab_iceberg
ICEBERG_WAREHOUSE=s3://warehouse/iceberg

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=warehouse
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_DOCKER_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1

FLINK_JOBMANAGER_HOST=127.0.0.1
FLINK_REST_PORT=8081

# Phase B broker profile. These are local single-node endpoints and public lab defaults,
# not external credentials. Remote wrappers use this example file directly and never sync .env.
KAFKA_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=broker.cdc_lab.orders
KAFKA_TOPIC_PARTITIONS=3
KAFKA_CONSUMER_GROUP=p1-broker-parity-b1
DEBEZIUM_CONNECT_HOST=127.0.0.1
DEBEZIUM_CONNECT_PORT=8083
DEBEZIUM_CONNECTOR_NAME=p1-orders-connector
SCHEMA_REGISTRY_HOST=127.0.0.1
SCHEMA_REGISTRY_PORT=8085
SCHEMA_REGISTRY_DOCKER_URL=http://schema-registry:8081

# StarRocks is intentionally not part of Phase 1.1/core.
STARROCKS_HOST=127.0.0.1
STARROCKS_PORT=9030
